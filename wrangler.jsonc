{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yokai-1504-online",
  "main": "worker.ts",
  "compatibility_date": "2026-10-29",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "ratelimits": [
    {
      "name": "CREATE_RATE_LIMIT",
      "namespace_id": "15041001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "API_RATE_LIMIT",
      "namespace_id": "15041002",
      "simple": {
        "limit": 180,
        "period": 60
      }
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MATCHES",
        "class_name": "MatchRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "MatchRoom"
      ]
    }
  ]
}
